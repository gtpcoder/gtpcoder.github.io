<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Spelling Bee Reviewer (Inline JSON + Random Next + Toggle List)</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f5f5f5; color: #222; }
    header { background: #ffd54f; padding: 1rem 1.5rem; box-shadow: 0 2px 4px rgba(0,0,0,.1); }
    .app { display: flex; height: calc(100vh - 90px); }
    .sidebar { width: 35%; max-width: 400px; border-right: 1px solid #ddd; background: #fff; display: flex; flex-direction: column; }
    .controls { padding: .75rem; border-bottom: 1px solid #eee; }
    .controls input { width: 100%; padding: .5rem; border-radius: 999px; border: 1px solid #ccc; }
    .word-list { overflow-y: auto; flex: 1; }
    .word-item { padding: .6rem .9rem; cursor: pointer; border-bottom: 1px solid #f2f2f2; }
    .word-item.active { background: #ffe082; }
    .main { flex: 1; padding: 1rem 1.5rem; display: flex; flex-direction: column; gap: .7rem; }
    .toolbar { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; }
    .toolbar button { padding: .35rem .75rem; border-radius: 999px; border: 1px solid #ccc; background: #fff; cursor: pointer; }
    .card { background: #fff; padding: 1rem; border-radius: 12px; box-shadow: 0 2px 6px rgba(0,0,0,.06); flex: 1; }
    #quizArea { display: none; margin-top: .9rem; }
  </style>
</head>

<body>
<header>
  <h1>Spelling Bee Reviewer</h1>
  <p>JSON word list is stored inline.</p>
</header>

<div class="app">
  <aside class="sidebar">
    <div class="controls">
      <input id="searchBox" type="text" placeholder="Search word..." />
    </div>
    <div id="wordList" class="word-list"></div>
  </aside>

  <main class="main">
    <div class="toolbar">
      <button id="nextRandomBtn">Next Random</button>
      <div style="display:flex;align-items:center;gap:.4rem;">
        <label><input type="checkbox" id="quizToggle"> Quiz Mode</label>
        <button id="toggleSidebarBtn">Hide List</button>
      </div>
    </div>

    <section class="card">
      <h2 id="wordTitle">Choose a word</h2>
      <p id="pronunciation"></p>
      <p id="meta"></p>
      <p id="definition"></p>
      <button id="audioBtn">Play audio</button>
      <a id="mwLink" href="#" target="_blank" style="display:none;">Open MW</a>

      <div id="quizArea">
        <label for="answerInput">Type the spelling</label>
        <input id="answerInput" type="text">
        <button id="checkBtn">Check</button>
        <p id="resultMsg"></p>
      </div>
    </section>
  </main>
</div>

