<script>
let rawWords = JSON.parse(document.getElementById("wordData").textContent);
let filtered = rawWords.map((_,i)=>i);
let idx = 0;

const wordCache = {};
const sidebar = document.querySelector(".sidebar");
const toggleSidebarBtn = document.getElementById("toggleSidebarBtn");
let sidebarVisible = true;

const listEl=document.getElementById("wordList"),
searchBox=document.getElementById("searchBox"),
wordTitle=document.getElementById("wordTitle"),
pronEl=document.getElementById("pronunciation"),
metaEl=document.getElementById("meta"),
defEl=document.getElementById("definition"),
audioBtn=document.getElementById("audioBtn"),
quizToggle=document.getElementById("quizToggle"),
quizArea=document.getElementById("quizArea"),
answerInput=document.getElementById("answerInput"),
checkBtn=document.getElementById("checkBtn"),
resultMsg=document.getElementById("resultMsg"),
mwLink=document.getElementById("mwLink");
quizToggle.addEventListener("change", () => {
    showWord(false);
});

function renderList(){
  listEl.innerHTML="";
  filtered.forEach((i,pos)=>{
    const w=rawWords[i];
    const div=document.createElement("div");
    div.className="word-item"+(pos===idx?" active":"");
    div.textContent=w;
    div.onclick=()=>{ idx=pos; showWord(true); };
    listEl.appendChild(div);
  });
}

async function fetchInfo(word){
  if(wordCache[word]) return wordCache[word];
  try{
    const res=await fetch("https://api.dictionaryapi.dev/api/v2/entries/en/"+encodeURIComponent(word));
    const data=await res.json();
    const e=data[0], m=e.meanings[0], p=e.phonetics.find(x=>x.audio)||{};
    return wordCache[word]={ def:m.definitions[0].definition, pos:m.partOfSpeech, pron:p.text||"", audio:p.audio||"" };
  }catch{
    return wordCache[word]={ def:"(No definition)", pos:"", pron:"", audio:"" };
  }
}

async function showWord(playAudio){
  renderList();
  const word = rawWords[filtered[idx]];
  const info = await fetchInfo(word);
  const quiz = quizToggle.checked;				

  wordTitle.textContent = quiz ? "Spell this word" : word;
  pronEl.textContent = quiz ? "" : ("Pronunciation: "+info.pron);
  pronEl.style.display = quiz ? "none" : "block";
  quizArea.style.display = quiz ? "block" : "none";	
  metaEl.textContent = "Part of speech: "+info.pos;
  defEl.textContent = info.def;

  mwLink.href="https://www.merriam-webster.com/dictionary/"+encodeURIComponent(word);
  mwLink.style.display="inline";

  quizArea.style.display = quizToggle.checked ? "block" : "none";
  resultMsg.textContent="";
  answerInput.value="";

  audioBtn.onclick = ()=>{
    if(info.audio){ new Audio(info.audio).play().catch(()=>tts(word)); }
    else tts(word);
  };

  if(playAudio) audioBtn.click();
}

function tts(w){
  const u=new SpeechSynthesisUtterance(w);
  u.lang="en-US";
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}

searchBox.oninput = ()=>{
  const q=searchBox.value.toLowerCase();
  filtered = rawWords.map((w,i)=>({w,i})).filter(o=>o.w.toLowerCase().includes(q)).map(o=>o.i);
  idx=0;
  showWord(false);
};

checkBtn.onclick=()=>{
  const guess=answerInput.value.trim().toLowerCase();
  const correct=rawWords[filtered[idx]].toLowerCase();
  if(!guess){ resultMsg.textContent="Enter spelling"; return; }
  resultMsg.textContent = guess===correct ? "✓ Correct!" : "✗ Incorrect. Correct: "+correct;
  resultMsg.style.color = guess===correct ? "green" : "red";
};

document.getElementById("nextRandomBtn").onclick = ()=>{
  let newPos;
  do{ newPos=Math.floor(Math.random()*filtered.length); }
  while(newPos===idx && filtered.length>1);
  idx=newPos;
  showWord(true);
};

toggleSidebarBtn.onclick=()=>{
  sidebarVisible=!sidebarVisible;
  sidebar.style.display = sidebarVisible ? "" : "none";
  toggleSidebarBtn.textContent = sidebarVisible ? "Hide List" : "Show List";
};

renderList();
showWord(false);
</script>

